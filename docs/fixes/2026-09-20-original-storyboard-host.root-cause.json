    "src/workbench/capability/capabilityApplyHandler.ts",
    "electron/capabilityCore/appIntegration.ts"
  ],
  "entry_points": [
    "StoryboardWorkspace Run selection",
    "Original editor controls"
  ],
  "external_sources": [],
  "internal_only_reason": "Existing storyboard materializer and original editor define placement; no external API changes",
  "invariants": [
    "Original StoryboardPlanEditor and its existing child controls are the only editor UI",
    "Run editing saves the complete editorial StoryboardPlan through exact source identity and content-token CAS, preserving execution snapshots even after submission.",
    "Dirty input survives remount and conflicting rereads",
    "Save flush drains later queued edits before actions",
    "Storage ports never replace the original single/variant/anchor/batch runner actions",
    "Captured Run bindings feed the original row materializer; existing nodes, dependencies and user overrides survive",
    "Node creation uses the existing materialization stamp boundary for concurrent idempotence",
    "Agent and editor use original batch admission, never rerun locked, completed or recoverable rows implicitly",
    "After asynchronous resolution, exact author target must still match before node writes and paid confirmation",
    "All asynchronous model and target reads finish before indexing materialization stamps; stamp lookup and node creation are one synchronous write segment",
    "Explicit placement includes standalone visual reference cards even when the plan currently has no shot rows; it never submits media",
    "PR #808 approved sidebar collapse and existing parameter degradation remain the current layout; no new minimum-width or horizontal-scroll strategy is introduced. Expanded-sidebar redesign is deferred.",
    "Transport operation discriminators are consumed by the original apply boundary and never passed as author fields to the strict shared storyboard schema.",
    "Explicit Place/View are optional original actions; single/variant/anchor/batch generation keeps on-demand materialization without a new placement gate."
  ],
