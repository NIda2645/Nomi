{
  "schema_version": 3,
  "id": "2026-09-20-original-storyboard-host",
  "problem_type": "Original storyboard behavior lost across Run storage adapters",
  "symptom": "Run plans lose existing storyboard table, reference and model interactions",
  "direct_cause": "Run host replaced existing actions with an incomplete present/compiler path and a second landing host; materialization checked stable stamps before awaited model/target reads, allowing concurrent duplicate creation The strict original author schema also received the canvas command operation discriminator, so valid legacy propose_storyboard_plan writes failed; the command envelope must be removed before author parsing.",
  "class_root": "Storage and binding differences were allowed to replace original executable behavior and duplicate in-flight ownership",
  "affected_population": [
    "Run-backed storyboard plans"
  ],
  "scope_paths": [
    "src/workbench/creation/storyboard/StoryboardPlanEditor.tsx",
    "src/workbench/creation/storyboard/StoryboardWorkspace.tsx",
    "src/workbench/creation/storyboard/storyboardEditorHost.ts",
