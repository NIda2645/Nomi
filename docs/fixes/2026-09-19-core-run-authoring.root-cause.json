{
  "schema_version": 3,
  "id": "2026-09-19-core-run-authoring",
  "problem_type": "Creation edits lack a canonical Run transaction",
  "symptom": "A Run listed in creation cannot be opened and saved through its durable owner.",
  "direct_cause": "Legacy document design writes did not address the Run editorial owner; candidate-only saves reduced the original editor body and conflated author edits with execution snapshots.",
  "class_root": "The creation edit boundary lacks a source-bound atomic Run command.",
  "affected_population": [
    "Document-owned single and multiple shot Runs"
  ],
  "scope_paths": [
    "electron/productionRun/productionStoryboardAuthoring.ts",
    "electron/productionRun/productionRunReducer.ts",
    "electron/productionRun/productionRunTypes.ts",
    "electron/productionRun/productionRunRepository.ts",
    "electron/productionRun/canvasLandingHost.ts"
  ],
  "entry_points": [
    "Creation Run editor",
    "Production command IPC"
  ],
  "external_sources": [],
  "internal_only_reason": "Application write ownership is independent of the model catalog implementation.",
  "invariants": [
    "generationPlan.editorial is the complete StoryboardPlan author body; candidates and contracts retain execution snapshots.",
    "A save validates exact project/Run/operation and immutable source document id/revision/hash, then compares the author content token.",
    "Full author saves are atomic, including anchors, scenes, references, models, keyframes and intentionally empty plans.",
    "Editing after submission preserves approved candidates, contracts, jobs and authorization identity; changing a waiting quote revokes that pending authorization."
  ],
