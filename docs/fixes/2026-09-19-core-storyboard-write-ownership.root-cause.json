  ],
  "entry_points": [
    "Existing proposal transaction",
    "Existing direct canvas tool calls"
  ],
  "external_sources": [],
  "internal_only_reason": "Application write ownership is independent of the model catalog implementation.",
  "invariants": [
    "Await never retargets a write to current focus",
    "A late result never replaces content edited after it started",
    "Loaded canvas replacement invalidates pending writes",
    "Original StoryboardPlan is the sole editable author body; saving it never rewrites approved candidate or job identity.",
    "Save CAS compares canonical author content atomically, ignoring unrelated execution progress; waiting quotes are revoked on author edits.",
    "Run-scoped selected shot references encode stable shot IDs, are captured synchronously, reject foreign document/Run chips and constrain every patch/present at the transport boundary."
  ],
