    "electron/shared/storyboard/storyboardPlanSchema.ts",
    "electron/shared/agentCapabilities/verbs/verbFieldProvenance.ts",
    "electron/productionRun/productionRunIpc.ts",
    "electron/capabilityCore/pendingSpendReferences.ts",
